      "question": "What is SCHNAIL?",
      "decision": "answer",
      "records": [
        "starcraft:schnail:features"
      ],
      "level": "gentle",
      "text": "SCHNAIL is the guide's client-based option for playing advanced Brood War opponents."
    },
    {
      "question": "How do I install BWAILauncher?",
      "decision": "answer",
      "records": [
        "starcraft:bwai:setup"
      ],
      "level": "gentle",
      "text": "For Brood War 1.16.1, put BWAILauncher in the game directory and launch through it. If detection fails, check the path to Starcraft.exe."
    },
    {
      "question": "How do I use the Remastered SCM map?",
      "decision": "answer",
      "records": [
        "starcraft:remastered-map:setup"
      ],
      "level": "gentle",
      "text": "In Remastered, use the integrated map through a Custom Game and select Use Map Settings."
    },
    {
      "question": "How do I use the Remastered SCM map?",
      "decision": "answer",
      "records": [
        "starcraft:remastered-map:setup"
      ],
      "level": "direct",
      "text": "Ensure StarCraft Remastered is installed and updated.; Download the BWAPI integrated SCM map archive from Proton Drive or Direct Download.; Extract the downloaded ZIP file to your StarCraft maps folder (typically Documents\\StarCraft\\Maps).; Launch StarCraft Remastered.; Navigate to Single Player \u2192 Custom Game.; Select the extracted BWAPI map.; Crucial Step: Under Game Type, you MUST select \"Use Map Settings\". The AI will not function properly in a standard Melee game.; Start the game and enjoy playing against the advanced AI!"
    },
    {
      "question": "smaller hint",
      "decision": "answer",
      "records": [
        "starcraft:remastered-map:setup"
      ],
      "level": "balanced",
      "text": "Extract the archive into Documents\\StarCraft\\Maps, open Single Player \u2192 Custom Game, select the map, then select Use Map Settings rather than Melee."
    },
